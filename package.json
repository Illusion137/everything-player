{
  "name": "react-native-everything-player",
  "version": "0.1.0",
  "description": "Full-featured React Native media player (direct, HLS and YouTube SABR) built on Nitro Modules",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "electron": {
        "types": "./lib/typescript/src/electron/index.d.ts",
        "import": "./lib/module/electron/index.js",
        "default": "./lib/commonjs/electron/index.js"
      },
      "browser": {
        "types": "./lib/typescript/src/electron/index.d.ts",
        "import": "./lib/module/electron/index.js",
        "default": "./lib/commonjs/electron/index.js"
      },
      "import": "./lib/module/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./electron": {
      "types": "./lib/typescript/src/electron/index.d.ts",
      "import": "./lib/module/electron/index.js",
      "default": "./lib/commonjs/electron/index.js"
    },
    "./electron/main": {
      "types": "./lib/typescript/src/electron/main.d.ts",
      "default": "./lib/commonjs/electron/main.js"
    },
    "./electron/preload": {
      "types": "./lib/typescript/src/electron/preload.d.ts",
      "default": "./lib/commonjs/electron/preload.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "specs": "nitrogen --logLevel=\"debug\"",
    "build": "bob build",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "nitro",
    "audio",
    "player",
    "track-player",
    "sabr",
    "hls",
    "electron"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.c",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "shaka-player": "^5.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "electron": "^44.9.0",
    "nitrogen": "0.37.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.37.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0",
    "electron": ">=30"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    }
  }
}
