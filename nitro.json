{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["everythingplayer"],
  "ios": {
    "iosModuleName": "EverythingPlayer"
  },
  "android": {
    "androidNamespace": ["everythingplayer"],
    "androidCxxLibName": "EverythingPlayer"
  },
  "autolinking": {
    "EverythingPlayer": {
      "ios": { "language": "swift", "implementationClassName": "HybridEverythingPlayer" },
      "android": { "language": "kotlin", "implementationClassName": "HybridEverythingPlayer" }
    },
    "DownloadManager": {
      "ios": { "language": "swift", "implementationClassName": "HybridDownloadManager" },
      "android": { "language": "kotlin", "implementationClassName": "HybridDownloadManager" }
    },
    "VideoSurface": {
      "ios": { "language": "swift", "implementationClassName": "HybridVideoSurface" },
      "android": { "language": "kotlin", "implementationClassName": "HybridVideoSurface" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
